{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Python: Ruff Format",
            "type": "shell",
            "command": "/usr/bin/zsh",
            "args": [
                "-lc",
                "source /home/vscode/.local/ha-venv/bin/activate && ruff format custom_components/ksenia_lares/*.py"
            ],
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Python: Ruff Lint + Fix",
            "type": "shell",
            "command": "/usr/bin/zsh",
            "args": [
                "-lc",
                "source /home/vscode/.local/ha-venv/bin/activate && ruff check custom_components/ksenia_lares/*.py --fix"
            ],
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}